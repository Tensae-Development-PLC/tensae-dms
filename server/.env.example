NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dms?schema=public"
JWT_ACCESS_SECRET="replace-with-at-least-32-characters-access-secret"
JWT_REFRESH_SECRET="replace-with-at-least-32-characters-refresh-secret"

# --- Deploy checklist: change these when moving from localhost to your VPS ---
# Browser app origin (invite, reset-password, share links)
PUBLIC_APP_BASE_URL="http://localhost:3000"
# Public API origin without /api/v1 (signed download URLs)
PUBLIC_API_BASE_URL="http://localhost:4000"
# Comma-separated browser origins allowed to call the API with credentials
CORS_ORIGIN="http://localhost:3000"
# ---------------------------------------------------------------------------

REFRESH_COOKIE_NAME="dms_refresh"
ADMIN_REFRESH_COOKIE_NAME="dms_admin_refresh"
# Omit or set false for local HTTP; production should use true / HTTPS
# COOKIE_SECURE="true"
# lax | strict | none — use none + Secure only for cross-site cookie auth
COOKIE_SAME_SITE="lax"
COOKIE_PATH="/"
# COOKIE_DOMAIN=".yourapp.com"
REFRESH_TOKEN_DAYS=7
REDIS_URL="redis://127.0.0.1:6379"
SIGNED_URL_SECRET="replace-with-at-least-32-character-signed-url-secret"
GLOBAL_RATE_LIMIT_MAX=500
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
SLOW_QUERY_THRESHOLD_MS=300

# Local VPS disk storage only (no S3). Persist this path via Docker volume in production.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./storage-data"

# Billing / subscriptions (false = free tier; UI gated until payment ships)
BILLING_ENABLED=false

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="you@example.com"
SMTP_PASS="replace-with-app-password"
SMTP_FROM="DMS <you@example.com>"
