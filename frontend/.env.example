# Copy to .env.local for local development (Next.js loads .env.local automatically)
#
# Deploy checklist — set these to your VPS IP or domain:
#   NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP/api/v1   (or http://localhost:4000/api/v1 locally)
#   NEXT_PUBLIC_APP_URL=http://YOUR_VPS_IP           (or http://localhost:3000 locally)
#   NEXT_PUBLIC_BILLING_ENABLED=false
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BILLING_ENABLED=false
