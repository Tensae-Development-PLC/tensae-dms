'use client'

import { isBillingEnabled } from '@/lib/public-url'
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card'
import { Badge } from '@/components/ui/badge'
import { CreditCard } from 'lucide-react'
import SubscriptionsAdminView from './subscriptions-view'

export default function SubscriptionsPage() {
  if (!isBillingEnabled()) {
    return (
      <div className="space-y-6">
        <div>
          <h1 className="text-2xl lg:text-3xl font-bold text-foreground">Subscriptions</h1>
          <p className="text-muted-foreground">Billing is disabled for this deployment (free tier)</p>
        </div>
        <Card>
          <CardHeader>
            <CardTitle className="flex items-center gap-2">
              <CreditCard className="w-5 h-5" />
              Coming soon
            </CardTitle>
            <CardDescription>
              Payment and subscription management will activate when billing is enabled.
            </CardDescription>
          </CardHeader>
          <CardContent className="space-y-3 text-sm text-muted-foreground">
            <p>
              Set both <Badge variant="secondary">BILLING_ENABLED=true</Badge> on the API and{' '}
              <Badge variant="secondary">NEXT_PUBLIC_BILLING_ENABLED=true</Badge> on the frontend to unlock this page.
            </p>
            <p>Until then, all tenants run on the free tier with quota limits only.</p>
          </CardContent>
        </Card>
      </div>
    )
  }

  return <SubscriptionsAdminView />
}
